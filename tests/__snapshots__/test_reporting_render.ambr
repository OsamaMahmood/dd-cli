# serializer version: 1
# name: test_render_html_snapshot
  '''
  <!doctype html>
  <html lang="en">
  <head>
  <meta charset="utf-8">
  <title>Security Report — Payments</title>
  <style>
    @page {
      size: A4;
      margin: 22mm 18mm 22mm 18mm;
      @top-left {
        content: "Payments — Security Report";
        font-family: 'Helvetica', sans-serif;
        font-size: 9pt;
        color: #666;
      }
      @bottom-right {
        content: "Page " counter(page) " of " counter(pages);
        font-family: 'Helvetica', sans-serif;
        font-size: 9pt;
        color: #666;
      }
    }
  
    html { -weasy-print-color-adjust: exact; }
    body {
      font-family: 'Helvetica', 'Arial', sans-serif;
      color: #1f2937;
      font-size: 10pt;
      line-height: 1.5;
    }
    h1, h2, h3, h4 { color: #0f172a; margin-top: 0; }
    h1 { font-size: 26pt; margin-bottom: 4pt; }
    h2 { font-size: 18pt; border-bottom: 2px solid #0f172a; padding-bottom: 4pt; margin-top: 18pt; }
    h3 { font-size: 14pt; margin-top: 14pt; color: #1e3a8a; }
    h4 { font-size: 11pt; margin-top: 10pt; }
  
    p { margin: 4pt 0; }
    ul, ol { margin: 4pt 0 4pt 16pt; padding: 0; }
    ul li, ol li { margin: 1pt 0; }
  
    .cover {
      text-align: left;
      padding: 30pt 0;
      border-bottom: 4px solid #0f172a;
      margin-bottom: 18pt;
    }
    .cover .meta { color: #64748b; font-size: 10pt; margin-top: 10pt; }
    .cover .meta div { margin: 2pt 0; }
  
    .summary-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 6pt;
      margin: 12pt 0 18pt;
    }
    .summary-card {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      padding: 8pt 10pt;
      border-radius: 4pt;
    }
    .summary-card .label { font-size: 7pt; color: #64748b; text-transform: uppercase; letter-spacing: 0.4pt; line-height: 1.2; }
    .summary-card .sub { font-size: 7pt; color: #64748b; margin-top: 2pt; }
    .summary-card .value { font-size: 18pt; font-weight: 700; color: #0f172a; line-height: 1.1; margin-top: 2pt; }
    .summary-card.alert {
      border-color: #fecaca;
      background: #fef2f2;
    }
    .summary-card.alert .value { color: #991b1b; }
    .summary-card.alert .label { color: #991b1b; }
  
    .severity-row {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 6pt;
      margin: 8pt 0 18pt;
    }
    .sev-card {
      padding: 8pt;
      border-radius: 4pt;
      text-align: center;
      color: #fff;
    }
    .sev-card .n { font-size: 16pt; font-weight: 700; display: block; }
    .sev-card .l { font-size: 8pt; text-transform: uppercase; letter-spacing: 0.5pt; }
    .sev-Critical { background: #991b1b; }
    .sev-High { background: #dc2626; }
    .sev-Medium { background: #d97706; }
    .sev-Low { background: #2563eb; }
    .sev-Info { background: #475569; }
  
    .chip {
      display: inline-block;
      padding: 2pt 8pt;
      border-radius: 10pt;
      font-size: 8pt;
      font-weight: 700;
      color: #fff;
      text-transform: uppercase;
      letter-spacing: 0.5pt;
    }
    .chip.Critical { background: #991b1b; }
    .chip.High { background: #dc2626; }
    .chip.Medium { background: #d97706; }
    .chip.Low { background: #2563eb; }
    .chip.Info { background: #475569; }
  
    .badge {
      display: inline-block;
      padding: 1pt 6pt;
      border-radius: 3pt;
      font-size: 7.5pt;
      font-weight: 700;
      margin-right: 4pt;
      text-transform: uppercase;
      letter-spacing: 0.3pt;
    }
    .badge-kev { background: #7c2d12; color: #fef3c7; }
    .badge-epss { background: #0f172a; color: #fef3c7; }
    .badge-fix { background: #166534; color: #fff; }
    .badge-exploited { background: #991b1b; color: #fff; }
  
    .sla-ok { background: #dcfce7; color: #166534; padding: 1pt 6pt; border-radius: 3pt; font-size: 8pt; font-weight: 700; }
    .sla-warn { background: #fef3c7; color: #92400e; padding: 1pt 6pt; border-radius: 3pt; font-size: 8pt; font-weight: 700; }
    .sla-breach { background: #fee2e2; color: #991b1b; padding: 1pt 6pt; border-radius: 3pt; font-size: 8pt; font-weight: 700; }
    .sla-none { background: #f1f5f9; color: #64748b; padding: 1pt 6pt; border-radius: 3pt; font-size: 8pt; font-weight: 700; }
  
    .engagement {
      page-break-before: always;
    }
    .engagement:first-of-type { page-break-before: avoid; }
  
    .engagement-meta, .test-meta {
      background: #f1f5f9;
      border-left: 3px solid #1e3a8a;
      padding: 8pt 12pt;
      margin: 6pt 0 10pt;
      font-size: 9pt;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2pt 18pt;
    }
    .engagement-meta div, .test-meta div { margin: 0; }
    .engagement-meta strong, .test-meta strong {
      color: #475569;
      font-size: 7.5pt;
      text-transform: uppercase;
      letter-spacing: 0.4pt;
      font-weight: 700;
      margin-right: 6pt;
    }
  
    .test {
      margin-top: 18pt;
      page-break-inside: avoid;
    }
    .empty-test {
      background: #f8fafc;
      border: 1px dashed #cbd5e1;
      color: #64748b;
      padding: 10pt;
      border-radius: 4pt;
      font-style: italic;
    }
  
    .finding {
      margin-top: 12pt;
      border: 1px solid #e2e8f0;
      border-radius: 4pt;
      padding: 10pt 12pt;
      page-break-inside: avoid;
    }
    .finding h4 {
      display: flex;
      align-items: center;
      gap: 8pt;
      margin: 0 0 6pt;
    }
    .finding-meta {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3pt 18pt;
      font-size: 9pt;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 3pt;
      padding: 8pt 12pt;
      margin: 8pt 0 10pt;
    }
    .finding-meta .row { display: flex; gap: 8pt; align-items: baseline; min-width: 0; }
    .finding-meta .k {
      color: #64748b;
      font-weight: 700;
      font-size: 7.5pt;
      text-transform: uppercase;
      letter-spacing: 0.4pt;
      min-width: 78pt;
      flex-shrink: 0;
      padding-top: 1pt;
    }
    .finding-meta .v {
      color: #1f2937;
      flex: 1;
      word-break: break-word;
      overflow-wrap: anywhere;
    }
    .finding-meta .v code {
      font-size: 8.5pt;
      background: #fff;
      border: 1px solid #e2e8f0;
    }
    .finding-section {
      margin-top: 8pt;
    }
    .finding-section .label {
      font-weight: 700;
      font-size: 9pt;
      color: #0f172a;
      margin-bottom: 2pt;
      text-transform: uppercase;
      letter-spacing: 0.4pt;
    }
    .finding-section .body {
      font-size: 9.5pt;
    }
    .finding-section .body p { margin: 4pt 0; }
    .finding-section .body code {
      font-family: 'Menlo', monospace;
      background: #f1f5f9;
      padding: 1pt 4pt;
      border-radius: 2pt;
      font-size: 8.5pt;
    }
    .finding-section .body pre {
      background: #0f172a;
      color: #f1f5f9;
      padding: 6pt 8pt;
      border-radius: 3pt;
      font-size: 8.5pt;
      overflow-x: auto;
      white-space: pre-wrap;
    }
    .finding-section .body pre code { background: transparent; padding: 0; color: inherit; }
  
    code, .mono {
      font-family: 'Menlo', 'Courier New', monospace;
      font-size: 9pt;
      background: #f1f5f9;
      padding: 1pt 4pt;
      border-radius: 2pt;
    }
    .tags { font-size: 8pt; color: #64748b; margin-top: 6pt; }
  
    table { width: 100%; border-collapse: collapse; margin: 8pt 0; }
    th, td { text-align: left; padding: 4pt 8pt; border-bottom: 1px solid #e2e8f0; font-size: 9pt; vertical-align: top; }
    th { background: #f8fafc; font-weight: 700; }
    thead { display: table-header-group; }
    tr { page-break-inside: avoid; break-inside: avoid; }
  
    .top-risk-table td.title { max-width: 240pt; }
    .top-risk-table .rank { width: 18pt; color: #64748b; font-weight: 700; }
    .top-risk-table tr, .top-risk-table thead { page-break-inside: avoid; }
    .top-risk-table thead { display: table-header-group; }
    .top-risk-table tbody tr { page-break-inside: avoid; break-inside: avoid; }
  
    .evidence-grid {
      display: grid;
      grid-template-columns: 110pt 1fr;
      gap: 4pt 10pt;
      font-size: 9pt;
      margin-top: 4pt;
    }
    .evidence-grid .k { color: #64748b; font-weight: 700; }
    .evidence-grid .v { font-family: 'Menlo', monospace; font-size: 8.5pt; word-break: break-all; }
  
    .delta-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6pt; margin: 6pt 0; }
    .delta-card { padding: 6pt 8pt; border-radius: 3pt; text-align: center; font-size: 9pt; }
    .delta-created { background: #fee2e2; color: #991b1b; }
    .delta-reactivated { background: #fef3c7; color: #92400e; }
    .delta-closed { background: #dcfce7; color: #166534; }
    .delta-untouched { background: #f1f5f9; color: #475569; }
    .delta-card .n { display: block; font-size: 13pt; font-weight: 700; }
    .delta-card .l { font-size: 7.5pt; text-transform: uppercase; letter-spacing: 0.4pt; }
  
    .ra-card {
      border: 1px solid #fef3c7;
      background: #fffbeb;
      border-left: 4px solid #d97706;
      padding: 10pt 12pt;
      margin: 10pt 0;
      border-radius: 3pt;
      page-break-inside: avoid;
    }
    .ra-card h4 { margin: 0 0 4pt; color: #92400e; }
    .ra-meta { font-size: 8.5pt; color: #78350f; margin-bottom: 6pt; }
    .ra-meta span { margin-right: 10pt; }
  
    .notes-block { background: #f8fafc; border-left: 3px solid #64748b; padding: 6pt 10pt; margin-top: 8pt; font-size: 9pt; }
    .notes-block .note { padding: 3pt 0; border-bottom: 1px dashed #e2e8f0; }
    .notes-block .note:last-child { border-bottom: none; }
    .notes-block .author { font-weight: 700; color: #1e3a8a; }
    .notes-block .date { color: #64748b; font-size: 8pt; }
  
    .jira-row { background: #eff6ff; border-left: 3px solid #1d4ed8; padding: 6pt 10pt; margin-top: 8pt; font-size: 9pt; }
    .jira-row a { color: #1d4ed8; text-decoration: none; font-weight: 700; }
  
    .endpoint-table { font-size: 8.5pt; margin-top: 6pt; }
    .endpoint-table th, .endpoint-table td { padding: 3pt 6pt; }
  </style>
  </head>
  <body>
  
