# Anything not needed in the image build context.
# .git is INCLUDED (not excluded) because hatch-vcs needs it to derive
# the package version from git tags. The runtime stage doesn't ship it.

# CI/dev tooling
.github/
.vscode/
.idea/

# Tests + fixtures (image is a runtime, not a CI runner)
tests/
docs/

# Build artifacts + caches
build/
dist/
*.egg-info/
.eggs/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local-only / secrets
.venv/
venv/
env-file.txt
*.env
.env
data/

# OS noise
.DS_Store
